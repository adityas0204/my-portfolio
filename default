# Default server configuration
#
server {
	listen 443 ssl;
	listen [::]:443 ssl ipv6only=on;

	server_name soniaditya.com www.soniaditya.com;

	ssl_certificate /etc/nginx/ssl/cloudflare_cert.pem;
	ssl_certificate_key /etc/nginx/ssl/cloudflare_key.pem;

	ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

	location / {
		root /usr/share/nginx/html;
		index index.html;
		try_files $uri $uri/ /index.html;
	}

	location /api/ {
		proxy_pass http://server:3001;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection 'upgrade';
		proxy_set_header Host $host;
		proxy_cache_bypass $http_upgrade;

    	# This keeps your analytics/logging accurate!
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}	
}

server {
	listen 80;
	listen [::]:80;
	server_name soniaditya.com;
	return 301 https://$host$request_uri;
}